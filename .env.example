NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider keys. Free-tier model selection and fallback order are managed in code.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Required for production email delivery.
RESEND_API_KEY=
OUTBOUND_EMAIL_FROM=RelayDesk <support@your-verified-domain.com>
EMAIL_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=your-resend-receiving-domain.resend.app

# Required for automatic custom-domain registration and HTTPS provisioning.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
